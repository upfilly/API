# Port & Node Environment
PORT=6043
NODE_ENV=development

# Base Platform Domain (e.g. upfilly.com)
# Subdomains will resolve as: <subdomain>.upfilly.com
APP_BASE_DOMAIN=upfilly.com

# Multi-Tenancy Dedicated Cluster MongoDB Root URI
# Used to provision dedicated tenant databases: upfilly_tenant_<subdomain>
MONGODB_ROOT_URI="mongodb://JC_neWsE18rVbeRvE09RAdM24In:JC_NEws18IuyYDrSdB09SERSve24SR@209.46.122.17:27017/?authSource=admin&directConnection=true"

# Master Database Name (Holds tenants registry & domainmappings)
# Defaults to: upfilly_master (or db_upfilly if unified with live database)
MASTER_DB_NAME=upfilly_master

# Prefix for auto-provisioned dedicated tenant databases
TENANT_DB_PREFIX=upfilly_tenant_

